<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CONVERTit.App.Controls"
             x:Class="CONVERTit.App.Views.DependenciesView">
  <!-- DataContext: DependenciesViewModel -->
  <ScrollViewer>
    <StackPanel Spacing="16" MaxWidth="1100" HorizontalAlignment="Left">

      <!-- Overview: every dependency with a status dot and a fixed-width state pill -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BrushChip}" Margin="0,0,14,0">
              <PathIcon Data="{StaticResource IconPuzzle}" Width="22" Height="22" Foreground="{DynamicResource BrushAccentIcon}" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
              <TextBlock Classes="h2" Text="{DynamicResource HdrDependencyOverview}" />
              <TextBlock Classes="small muted" Text="{Binding OverviewSummary}" />
            </StackPanel>
          </Grid>
          <Border Classes="inset">
            <ItemsControl ItemsSource="{Binding Overview}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Spacing="8" /></ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid ColumnDefinitions="Auto,170,*,Auto,Auto">
                    <Ellipse Width="10" Height="10" Margin="0,0,12,0" VerticalAlignment="Center"
                             Classes="statusdot" Classes.ready="{Binding Ready}" />
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2" Classes="small muted" Text="{Binding Purpose}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="3" Classes="small mono muted" Text="{Binding Version}" Margin="12,0" VerticalAlignment="Center" />
                    <Border Grid.Column="4" Classes="pill" Classes.ok="{Binding Ready}" Classes.warn="{Binding Missing}" Width="130">
                      <TextBlock Classes="small" Text="{Binding StateText}" HorizontalAlignment="Center" />
                    </Border>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>
          <ctl:CenterWrapPanel HorizontalAlignment="Stretch">
            <Button Margin="4,0,4,8" Command="{Binding CheckAllCommand}">
              <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnCheckAll}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding UpdateAllCommand}">
              <ctl:IconLabel Icon="{StaticResource IconUpdate}" Text="{DynamicResource BtnUpdateAll}" />
            </Button>
            <Button Margin="4,0,4,8" Classes="primary" Command="{Binding InstallMissingCommand}" IsEnabled="{Binding AnyMissing}">
              <ctl:IconLabel Icon="{StaticResource IconDownload}" Text="{DynamicResource BtnInstallMissing}" />
            </Button>
          </ctl:CenterWrapPanel>
        </StackPanel>
      </Border>

      <!-- FFmpeg -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BrushChip}" Margin="0,0,14,0">
              <PathIcon Data="{StaticResource IconChip}" Width="22" Height="22" Foreground="{DynamicResource BrushAccentIcon}" />
            </Border>
            <TextBlock Grid.Column="1" Classes="h2" Text="FFmpeg / ffprobe" VerticalAlignment="Center" />
            <Border Grid.Column="2" Classes="pill ok" IsVisible="{Binding FfmpegReady}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconCheckCircle}" Width="14" Height="14" />
                <TextBlock Classes="small" Text="{DynamicResource StateReady}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="pill warn" IsVisible="{Binding FfmpegMissing}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <PathIcon Data="{StaticResource IconAlert}" Width="14" Height="14" />
                <TextBlock Classes="small" Text="{DynamicResource StateMissing}" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="inset">
            <!-- All values plain text on one left edge (no pills: their padding shifted Version/Path to the right) -->
            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
              <TextBlock Classes="muted" Text="{DynamicResource LblVersion}" Margin="0,0,0,8" />
              <SelectableTextBlock Grid.Column="1" Text="{Binding FfmpegVersion}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Classes="muted" Text="{DynamicResource LblSource}" Margin="0,0,0,8" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FfmpegSourceText}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Grid.Row="2" Classes="muted" Text="{DynamicResource LblPath}" Margin="0,0,0,8" />
              <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="mono" Text="{Binding FfmpegPath}" TextWrapping="Wrap" Margin="0,0,0,8" />
              <TextBlock Grid.Row="3" Classes="muted" Text="{DynamicResource LblBuild}" IsVisible="{Binding HasInstalledBuild}" />
              <SelectableTextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InstalledBuild}" TextWrapping="Wrap" IsVisible="{Binding HasInstalledBuild}" />
            </Grid>
          </Border>

          <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}" IsVisible="{Binding IsBusy}" />

          <!-- Status as a colored pill (installed and verified, update available, error …) -->
          <Border Classes="pill" HorizontalAlignment="Center"
                  Classes.ok="{Binding StatusIsOk}" Classes.warn="{Binding StatusIsWarn}" Classes.danger="{Binding StatusIsError}"
                  Classes.neutral="{Binding StatusIsInfo}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <PathIcon Data="{Binding StatusIcon}" Width="14" Height="14" />
              <TextBlock Classes="small" Text="{Binding StatusDisplay}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <ctl:CenterWrapPanel HorizontalAlignment="Stretch">
            <Button Margin="4,0,4,8" Command="{Binding CheckUpdateCommand}" IsEnabled="{Binding !IsBusy}">
              <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnCheckUpdate}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding !IsBusy}">
              <ctl:IconLabel Icon="{StaticResource IconFolderSearch}" Text="{DynamicResource BtnChooseFfmpegFolder}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding ResetCustomCommand}" IsVisible="{Binding HasCustomPath}">
              <ctl:IconLabel Icon="{StaticResource IconUndo}" Text="{DynamicResource BtnAutoDetect}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding OpenFolderCommand}">
              <ctl:IconLabel Icon="{StaticResource IconFolderOpen}" Text="{DynamicResource BtnOpenFolder}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding InstallZipCommand}" IsEnabled="{Binding !IsBusy}">
              <ctl:IconLabel Icon="{StaticResource IconFileImport}" Text="{DynamicResource BtnInstallZip}" />
            </Button>
            <Button Margin="4,0,4,8" Command="{Binding RecheckCommand}" IsEnabled="{Binding !IsBusy}">
              <ctl:IconLabel Icon="{StaticResource IconFolderSearch}" Text="{DynamicResource BtnRecheck}" />
            </Button>
            <Button Margin="4,0,4,8" Classes="danger" Command="{Binding RemoveCommand}" IsVisible="{Binding IsDownloaded}">
              <ctl:IconLabel Icon="{StaticResource IconDelete}" Text="{DynamicResource BtnRemove}" />
            </Button>
            <Button Margin="4,0,4,8" Classes="primary" Command="{Binding DownloadCommand}" IsEnabled="{Binding !IsBusy}">
              <ctl:IconLabel Icon="{StaticResource IconDownload}" Text="{DynamicResource BtnDownloadInstall}" />
            </Button>
          </ctl:CenterWrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
            <Button Classes="link" Command="{Binding OpenReleasesCommand}">
              <ctl:IconLabel Icon="{StaticResource IconOpenInNew}" Text="github.com/BtbN/FFmpeg-Builds" IconSize="13" />
            </Button>
            <Button Classes="link" Command="{Binding OpenFfmpegLicenseCommand}">
              <ctl:IconLabel Icon="{StaticResource IconOpenInNew}" Text="ffmpeg.org/legal" IconSize="13" />
            </Button>
          </StackPanel>
          <ctl:HintText Hint="{DynamicResource HintFfmpegLicense}" HorizontalAlignment="Center" TextAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- Optional modules: AI upscaling and frame interpolation (opt-in downloads, nothing bundled) -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="Auto,*">
            <PathIcon Data="{StaticResource IconPuzzle}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentIcon}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="h2" Text="{DynamicResource HdrOptionalModules}" />
          </Grid>
          <ctl:HintText Hint="{DynamicResource HintOptionalModules}" />
          <SelectableTextBlock Classes="small muted" Text="{Binding SharedModulesText}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
      <ItemsControl ItemsSource="{Binding Modules}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate><StackPanel Spacing="16" /></ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Classes="card" Padding="22">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto">
                  <Border Width="46" Height="46" CornerRadius="12" Background="{DynamicResource BrushChip}" Margin="0,0,14,0">
                    <PathIcon Data="{StaticResource IconImageFilterHdr}" Width="22" Height="22" Foreground="{DynamicResource BrushAccentIcon}" />
                  </Border>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="h2" Text="{Binding Name}" />
                    <TextBlock Classes="small muted" Text="{Binding Description}" TextWrapping="Wrap" />
                  </StackPanel>
                  <Border Grid.Column="2" Classes="pill"
                          Classes.ok="{Binding StatusIsOk}" Classes.warn="{Binding StatusIsWarn}" Classes.danger="{Binding StatusIsError}"
                          Classes.neutral="{Binding StatusIsInfo}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{Binding StatusIcon}" Width="14" Height="14" />
                      <TextBlock Classes="small" Text="{Binding StatusDisplay}" TextWrapping="Wrap" MaxWidth="360" />
                    </StackPanel>
                  </Border>
                </Grid>
                <Border Classes="inset">
                  <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto">
                    <TextBlock Classes="muted" Text="{DynamicResource LblLicense}" Margin="0,0,0,8" />
                    <TextBlock Grid.Column="1" Text="{Binding License}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="1" Classes="muted" Text="{DynamicResource LblPath}" Margin="0,0,0,8" />
                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding FolderText}" TextWrapping="Wrap" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="2" Classes="muted" Text="{DynamicResource LblBuild}" IsVisible="{Binding HasInstalledText}" Margin="0,0,0,8" />
                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstalledText}" TextWrapping="Wrap" IsVisible="{Binding HasInstalledText}" Margin="0,0,0,8" />
                    <TextBlock Grid.Row="3" Classes="muted" Text="{DynamicResource LblExpected}" />
                    <SelectableTextBlock Grid.Row="3" Grid.Column="1" Classes="small mono" Text="{Binding ExpectedFiles}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding Progress}" IsVisible="{Binding IsBusy}" />
                <ctl:CenterWrapPanel HorizontalAlignment="Stretch">
                  <Button Margin="4,0,4,8" Command="{Binding OpenFolderCommand}">
                    <ctl:IconLabel Icon="{StaticResource IconFolderOpen}" Text="{DynamicResource BtnOpenFolder}" />
                  </Button>
                  <Button Margin="4,0,4,8" Command="{Binding ChooseFolderCommand}" IsEnabled="{Binding !IsBusy}">
                    <ctl:IconLabel Icon="{StaticResource IconFolderSearch}" Text="{DynamicResource BtnChooseFolder}" />
                  </Button>
                  <Button Margin="4,0,4,8" Command="{Binding ResetFolderCommand}" IsVisible="{Binding HasCustomFolder}">
                    <ctl:IconLabel Icon="{StaticResource IconUndo}" Text="{DynamicResource BtnAutoDetect}" />
                  </Button>
                  <Button Margin="4,0,4,8" Command="{Binding InstallZipCommand}" IsEnabled="{Binding !IsBusy}">
                    <ctl:IconLabel Icon="{StaticResource IconFileImport}" Text="{DynamicResource BtnInstallZip}" />
                  </Button>
                  <Button Margin="4,0,4,8" Command="{Binding RecheckCommand}" IsEnabled="{Binding !IsBusy}">
                    <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnRecheck}" />
                  </Button>
                  <Button Margin="4,0,4,8" Classes="danger" Command="{Binding RemoveCommand}" IsVisible="{Binding CanRemove}">
                    <ctl:IconLabel Icon="{StaticResource IconDelete}" Text="{DynamicResource BtnRemove}" />
                  </Button>
                  <Button Margin="4,0,4,8" Classes="primary" Command="{Binding DownloadCommand}" IsEnabled="{Binding !IsBusy}">
                    <ctl:IconLabel Icon="{StaticResource IconDownload}" Text="{DynamicResource BtnDownloadInstall}" />
                  </Button>
                </ctl:CenterWrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
                  <Button Classes="link" Command="{Binding OpenHomepageCommand}">
                    <ctl:IconLabel Icon="{StaticResource IconOpenInNew}" Text="{DynamicResource BtnModulePage}" IconSize="13" />
                  </Button>
                  <Button Classes="link" Command="{Binding OpenLicenseCommand}">
                    <ctl:IconLabel Icon="{StaticResource IconOpenInNew}" Text="{DynamicResource BtnLicenseText}" IconSize="13" />
                  </Button>
                  <TextBlock Classes="small muted" Text="{Binding SizeText}" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Hardware encoders -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <PathIcon Data="{StaticResource IconGpu}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentIcon}" Margin="0,0,10,0" />
            <TextBlock Grid.Column="1" Classes="h2" Text="{DynamicResource HdrHardware}" />
            <Button Grid.Column="2" Command="{Binding RetestCommand}" IsEnabled="{Binding FfmpegReady}">
              <ctl:IconLabel Icon="{StaticResource IconRefresh}" Text="{DynamicResource BtnRetest}" />
            </Button>
          </Grid>
          <Grid ColumnDefinitions="160,140,90,*" Margin="0,4,0,0">
            <TextBlock Classes="section" Text="{DynamicResource ColEncoder}" />
            <TextBlock Grid.Column="1" Classes="section" Text="{DynamicResource ColVendor}" />
            <TextBlock Grid.Column="2" Classes="section" Text="{DynamicResource ColCodec}" />
            <TextBlock Grid.Column="3" Classes="section" Text="{DynamicResource ColState}" />
          </Grid>
          <Border Classes="divider" />
          <ItemsControl ItemsSource="{Binding Encoders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="160,140,90,*" Margin="0,3">
                  <TextBlock Classes="mono small" Text="{Binding Encoder}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Vendor}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Codec}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6">
                    <PathIcon Data="{StaticResource IconCheckCircle}" Width="14" Height="14" Foreground="{DynamicResource BrushAccentIcon}" IsVisible="{Binding Works}" />
                    <PathIcon Data="{StaticResource IconCloseCircle}" Width="14" Height="14" Foreground="{DynamicResource BrushTextDisabled}" IsVisible="{Binding !Works}" />
                    <TextBlock Classes="small" Text="{Binding State}" VerticalAlignment="Center" />
                  </StackPanel>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Components -->
      <Border Classes="card" Padding="22">
        <StackPanel Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <PathIcon Data="{StaticResource IconPackage}" Width="20" Height="20" Foreground="{DynamicResource BrushAccentIcon}" />
            <TextBlock Classes="h2" Text="{DynamicResource HdrComponents}" />
          </StackPanel>
          <!-- Header and rows share fixed column widths (Grid.IsSharedSizeScope) so every column starts on the same edge -->
          <StackPanel Grid.IsSharedSizeScope="True" Spacing="8">
            <Grid Margin="0,4,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="CompName" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="CompVersion" />
                <ColumnDefinition Width="Auto" SharedSizeGroup="CompLicense" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock Classes="section" Text="{DynamicResource ColComponent}" Margin="0,0,24,0" />
              <TextBlock Grid.Column="1" Classes="section" Text="{DynamicResource ColVersion}" Margin="0,0,24,0" />
              <TextBlock Grid.Column="2" Classes="section" Text="{DynamicResource ColLicense}" Margin="0,0,24,0" />
              <TextBlock Grid.Column="3" Classes="section" Text="{DynamicResource ColUsage}" />
            </Grid>
            <Border Classes="divider" />
            <ItemsControl ItemsSource="{Binding Components}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,3">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" SharedSizeGroup="CompName" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="CompVersion" />
                      <ColumnDefinition Width="Auto" SharedSizeGroup="CompLicense" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <TextBlock Grid.Column="1" Classes="muted" Text="{Binding Version}" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <TextBlock Grid.Column="2" Text="{Binding License}" VerticalAlignment="Center" Margin="0,0,24,0" />
                    <TextBlock Grid.Column="3" Classes="small muted" Text="{Binding Usage}" TextWrapping="Wrap" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
