<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CONVERTit.App.Controls"
             xmlns:parts="using:CONVERTit.App.Views.Parts"
             x:Class="CONVERTit.App.Views.ExtractAudioView">
  <parts:PageFrame>
    <StackPanel Spacing="16">
      <Border Classes="card">
        <StackPanel>
          <StackPanel Classes="cardhead">
            <PathIcon Data="{StaticResource IconExtract}" />
            <TextBlock Classes="h2" Text="{DynamicResource HdrExtract}" />
          </StackPanel>
          <Grid Classes="opts" ColumnDefinitions="*,280" RowDefinitions="Auto,Auto">
            <TextBlock Text="{DynamicResource LblExtractMode}" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Modes}" SelectedItem="{Binding Extract.Mode}" ItemTemplate="{StaticResource EnumLabel}" />
            <TextBlock Grid.Row="1" Text="{DynamicResource LblAllTracks}" />
            <ToggleSwitch Grid.Row="1" Grid.Column="1" IsChecked="{Binding Extract.AllTracks}" OnContent="" OffContent="" />
          </Grid>
        </StackPanel>
      </Border>
      <parts:AudioOptionsPanel DataContext="{Binding Audio}" IsVisible="{Binding $parent[UserControl].DataContext.IsConvert}" />
    </StackPanel>
  </parts:PageFrame>
</UserControl>
