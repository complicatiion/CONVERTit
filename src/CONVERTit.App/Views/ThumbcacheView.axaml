<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="using:CONVERTit.App.Controls"
             x:Class="CONVERTit.App.Views.ThumbcacheView">
  <!-- DataContext: ThumbcacheViewModel. Read-only viewer (only "Clean cache …" changes something, after an opt-in). -->
  <Panel>
    <DockPanel>
      <!-- Source: all caches of this user, a single size file, or any opened Thumbs.db -->
      <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <ComboBox ItemsSource="{Binding CacheChoices}" SelectedItem="{Binding SelectedChoice}" HorizontalAlignment="Stretch"
                      PlaceholderText="{DynamicResource ThumbcacheChooseOwn}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0">
              <Button Classes="danger" Command="{Binding CleanCacheCommand}" IsEnabled="{Binding !IsCleaning}">
                <ctl:IconLabel Icon="{StaticResource IconBroom}" Text="{DynamicResource BtnCleanCache}" />
              </Button>
              <Button Command="{Binding OpenCacheFolderCommand}">
                <ctl:IconLabel Icon="{StaticResource IconFolderOpen}" Text="{DynamicResource BtnOpenFolder}" />
              </Button>
              <Button Classes="primary" Command="{Binding PickFileCommand}">
                <ctl:IconLabel Icon="{StaticResource IconFolderSearch}" Text="{DynamicResource BtnOpenCacheFile}" />
              </Button>
            </StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="small muted" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0">
              <TextBlock Classes="small" Text="{DynamicResource LblHideDuplicates}" VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding HideDuplicates}" OnContent="" OffContent="" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
              <TextBlock Classes="small" Text="{DynamicResource LblOnlyMarked}" VerticalAlignment="Center" />
              <ToggleSwitch IsChecked="{Binding OnlyMarked}" OnContent="" OffContent="" />
            </StackPanel>
          </Grid>
          <ctl:HintText Hint="{DynamicResource HintThumbcache}" />
        </StackPanel>
      </Border>

      <!-- Footer: count, select all / none (icon in the accent color when everything is selected), export -->
      <Border DockPanel.Dock="Bottom" Padding="0,14,0,0">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="muted" Text="{Binding CountText}" VerticalAlignment="Center" IsVisible="{Binding HasItems}" TextTrimming="CharacterEllipsis" />
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Classes="icon selectall" Classes.on="{Binding AllSelected}" Command="{Binding ToggleSelectAllCommand}" IsEnabled="{Binding HasItems}"
                    ToolTip.Tip="{DynamicResource TipSelectAllNone}">
              <PathIcon Data="{StaticResource IconSelectAll}" />
            </Button>
            <Button Command="{Binding ExportMarkedCommand}" IsVisible="{Binding HasMarks}">
              <ctl:IconLabel Icon="{StaticResource IconStar}" Text="{DynamicResource BtnExportMarked}" />
            </Button>
            <Button Command="{Binding ExportSelectedCommand}" IsEnabled="{Binding HasSelection}">
              <ctl:IconLabel Icon="{StaticResource IconExport}" Text="{DynamicResource BtnExportSelected}" />
            </Button>
            <Button Classes="primary" Command="{Binding ExportAllCommand}" IsEnabled="{Binding HasItems}">
              <ctl:IconLabel Icon="{StaticResource IconExport}" Text="{DynamicResource BtnExportAll}" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Classes="card" Padding="12">
        <Panel>
          <DockPanel>
            <Button DockPanel.Dock="Bottom" HorizontalAlignment="Center" Margin="0,10,0,2" Command="{Binding ShowMoreCommand}" IsVisible="{Binding HasMore}">
              <ctl:IconLabel Icon="{StaticResource IconChevronDown}" Text="{Binding MoreText}" />
            </Button>
            <!-- Explorer-like selection: click, Ctrl/Shift + click, Ctrl+A, arrows; double-click / Enter / Space = viewer -->
            <ListBox x:Name="ThumbGrid" Classes="thumbs" ItemsSource="{Binding Visible}" SelectionMode="Multiple"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Width="164" Spacing="6" ToolTip.Tip="{Binding Label}">
                    <Panel>
                      <Border Height="130" CornerRadius="6" Background="{DynamicResource BrushSurfaceRaised}" ClipToBounds="True">
                        <Image Source="{Binding Image}" Stretch="Uniform" />
                      </Border>
                      <Border Classes="badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6" IsVisible="{Binding IsMarked}">
                        <PathIcon Data="{StaticResource IconStar}" Width="14" Height="14" />
                      </Border>
                    </Panel>
                    <TextBlock Classes="small" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="small muted" Text="{Binding Details}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
          <ProgressBar IsIndeterminate="True" Width="160" VerticalAlignment="Center" HorizontalAlignment="Center" IsVisible="{Binding IsLoading}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding IsEmpty}">
            <PathIcon Data="{StaticResource IconViewGrid}" Width="36" Height="36" Foreground="{DynamicResource BrushTextSecondary}" />
            <TextBlock Classes="muted" Text="{DynamicResource ThumbcacheDrop}" HorizontalAlignment="Center" />
            <TextBlock Classes="small muted" Text="{Binding StatusText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
          </StackPanel>
        </Panel>
      </Border>
    </DockPanel>

    <!-- ===================================================== Mini image viewer -->
    <Border x:Name="Viewer" Classes="dim" IsVisible="{Binding IsViewerOpen}" Focusable="True">
      <Border Classes="dialog" Margin="24" Padding="16">
        <DockPanel>
          <!-- Title, position, close -->
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,10">
            <StackPanel VerticalAlignment="Center">
              <TextBlock Classes="h3" Text="{Binding ViewerTitle}" TextTrimming="CharacterEllipsis" />
              <TextBlock Classes="small muted" Text="{Binding ViewerInfo}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <TextBlock Grid.Column="1" Classes="mono small muted" Text="{Binding ViewerPosition}" VerticalAlignment="Center" Margin="12,0" />
            <Button Grid.Column="2" Classes="icon close" Command="{Binding CloseViewerCommand}" ToolTip.Tip="{DynamicResource TipCloseEsc}">
              <PathIcon Data="{StaticResource IconClose}" />
            </Button>
          </Grid>

          <!-- Controls: previous / next, zoom, mark, copy, export -->
          <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,*" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Classes="icon" Command="{Binding ZoomOutCommand}" ToolTip.Tip="−">
                <PathIcon Data="{StaticResource IconMagnifyMinus}" />
              </Button>
              <Button Classes="icon" Command="{Binding ZoomInCommand}" ToolTip.Tip="+">
                <PathIcon Data="{StaticResource IconMagnifyPlus}" />
              </Button>
              <Button Classes="icon" Command="{Binding ZoomFitCommand}" ToolTip.Tip="{DynamicResource ZoomFit}">
                <PathIcon Data="{StaticResource IconFitScreen}" />
              </Button>
              <Button Command="{Binding ZoomActualCommand}" Padding="10,6">
                <TextBlock Classes="small mono" Text="{Binding ZoomText}" />
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
              <Button Classes="icon" Command="{Binding ViewerPreviousCommand}" ToolTip.Tip="←">
                <PathIcon Data="{StaticResource IconChevronLeft}" />
              </Button>
              <Button Classes="icon" Command="{Binding ViewerNextCommand}" ToolTip.Tip="→">
                <PathIcon Data="{StaticResource IconChevronRight}" />
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
              <Button Classes="icon" Command="{Binding ToggleMarkCommand}" CommandParameter="{Binding ViewerItem}" ToolTip.Tip="{DynamicResource TipMark}">
                <Panel>
                  <PathIcon Data="{StaticResource IconStarOutline}" IsVisible="{Binding !ViewerItem.IsMarked}" />
                  <PathIcon Data="{StaticResource IconStar}" Foreground="{DynamicResource BrushAccentIcon}" IsVisible="{Binding ViewerItem.IsMarked}" />
                </Panel>
              </Button>
              <Button Command="{Binding CopyImageCommand}" CommandParameter="{Binding ViewerItem}">
                <ctl:IconLabel Icon="{StaticResource IconContentCopy}" Text="{DynamicResource BtnCopyImage}" />
              </Button>
              <Button Classes="primary" Command="{Binding ExportItemCommand}" CommandParameter="{Binding ViewerItem}">
                <ctl:IconLabel Icon="{StaticResource IconExport}" Text="{DynamicResource BtnExport}" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- Picture: fitted, or zoomed inside a scroll area (mouse wheel zooms) -->
          <Border x:Name="ViewerStage" CornerRadius="8" Background="{DynamicResource BrushSurfaceRaised}" ClipToBounds="True">
            <Panel>
              <Image Source="{Binding ViewerImage}" Stretch="Uniform" StretchDirection="DownOnly" IsVisible="{Binding ViewerFit}" Margin="8" />
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !ViewerFit}">
                <Image Source="{Binding ViewerImage}" Stretch="Fill" Width="{Binding ViewerWidth}" Height="{Binding ViewerHeight}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="MediumQuality" />
              </ScrollViewer>
            </Panel>
          </Border>
        </DockPanel>
      </Border>
    </Border>
  </Panel>
</UserControl>
