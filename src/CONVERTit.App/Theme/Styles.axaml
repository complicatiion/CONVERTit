<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctl="using:CONVERTit.App.Controls">

  <!-- ===================================================== Base -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BrushBgApp}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.h3">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="PathIcon">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
  </Style>
  <Style Selector="TextBlock.small">
    <Setter Property="FontSize" Value="12" />
  </Style>
  <!-- One style per type: a mixed selector resolves FontFamily on Control, which has no such property -->
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>
  <Style Selector="SelectableTextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>
  <Style Selector="TextBox.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
  </Style>
  <Style Selector="TextBlock.kpi">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.accent">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}" />
  </Style>
  <Style Selector="TextBlock.danger">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
  </Style>
  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{DynamicResource BrushWarning}" />
  </Style>
  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="LetterSpacing" Value="0.6" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style Selector="TextBlock.hint">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <!-- "Note:" hints (HintText control): a little air above, prefix in semibold -->
  <Style Selector="ctl|HintText">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <!-- ===================================================== Surfaces -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
    <Setter Property="Padding" Value="18" />
  </Style>
  <Style Selector="Border.inset">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="12" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <!-- Status pills: ok = neon on chip, warn = orange, danger = red, neutral = grey -->
  <Style Selector="Border.pill.ok">
    <Setter Property="Background" Value="{DynamicResource BrushChip}" />
  </Style>
  <Style Selector="Border.pill.ok TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentIcon}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pill.ok PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentIcon}" />
  </Style>
  <Style Selector="Border.pill.warn">
    <Setter Property="Background" Value="{DynamicResource BrushOrangeSoft}" />
  </Style>
  <Style Selector="Border.pill.warn TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushOrange}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pill.warn PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushOrange}" />
  </Style>
  <Style Selector="Border.pill.danger">
    <Setter Property="Background" Value="{DynamicResource BrushDangerSoft}" />
  </Style>
  <Style Selector="Border.pill.danger TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Border.pill.danger PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
  </Style>
  <Style Selector="Border.pill.neutral">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
  </Style>
  <Style Selector="Border.pill.neutral TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>
  <Style Selector="Border.pill.neutral PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="7,1" />
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.countbadge">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="7,0" />
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.countbadge > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
  </Style>
  <Style Selector="Border.banner">
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Background" Value="{DynamicResource BrushWarningSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushWarning}" />
  </Style>
  <Style Selector="Border.toast">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="BoxShadow" Value="0 8 28 0 #55000000" />
  </Style>
  <Style Selector="Border.toast PathIcon.toastIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentIcon}" />
    <Setter Property="Data" Value="{StaticResource IconCheckCircle}" />
  </Style>
  <Style Selector="Border.toast.error">
    <Setter Property="BorderBrush" Value="{DynamicResource BrushDanger}" />
  </Style>
  <Style Selector="Border.toast.error PathIcon.toastIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
    <Setter Property="Data" Value="{StaticResource IconAlertCircle}" />
  </Style>
  <!-- Drop zone: dashed accent outline -->
  <Style Selector="Rectangle.dropzone">
    <Setter Property="Stroke" Value="{DynamicResource BrushBorderStrong}" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeDashArray" Value="5,4" />
    <Setter Property="RadiusX" Value="12" />
    <Setter Property="RadiusY" Value="12" />
    <Setter Property="Fill" Value="Transparent" />
  </Style>
  <Style Selector="Panel.dropzone.dragover Rectangle.dropzone">
    <Setter Property="Stroke" Value="{DynamicResource BrushAccent}" />
    <Setter Property="Fill" Value="{DynamicResource BrushDropZone}" />
  </Style>

  <!-- Menus: clearly visible hover / keyboard selection -->
  <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource BrushMenuHover}" />
  </Style>
  <Style Selector="MenuItem:selected /template/ Border#PART_LayoutRoot">
    <Setter Property="Background" Value="{DynamicResource BrushMenuHover}" />
  </Style>

  <!-- ===================================================== IconLabel -->
  <Style Selector="ctl|IconLabel">
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <PathIcon Data="{TemplateBinding Icon}"
                    Width="{TemplateBinding IconSize}"
                    Height="{TemplateBinding IconSize}"
                    Foreground="{TemplateBinding Foreground}"
                    VerticalAlignment="Center" />
          <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- ===================================================== Buttons -->
  <Style Selector="Button, ToggleButton">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,7" />
  </Style>

  <!-- Main action: filled neon accent with dark text (contrast > 12:1) -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
  </Style>
  <Style Selector="Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentPressed}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
  </Style>
  <Style Selector="Button.primary:disabled /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextDisabled}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource BrushDanger}" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="#E14C59" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>

  <!-- Uniform buttons in dialogs and footers -->
  <Style Selector="Button.fixed">
    <Setter Property="MinWidth" Value="150" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Icon-only button -->
  <Style Selector="Button.icon, ToggleButton.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Width" Value="34" />
    <Setter Property="Height" Value="34" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.icon PathIcon, ToggleButton.icon PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
  </Style>
  <Style Selector="Button.icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
  </Style>
  <Style Selector="Button.icon.small">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="5" />
  </Style>
  <Style Selector="Button.icon.small PathIcon">
    <Setter Property="Width" Value="15" />
    <Setter Property="Height" Value="15" />
  </Style>
  <!-- Trim marks: square icon buttons -->
  <!-- Trim marks: thick arrow (→ start, ← end) in the accent color plus text -->
  <Style Selector="Button.mark">
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.mark ctl|IconLabel">
    <Setter Property="IconSize" Value="18" />
  </Style>

  <!-- Round play button of the player -->
  <Style Selector="Button.play">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="CornerRadius" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource BrushAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.play:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentHover}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushOnAccent}" />
  </Style>

  <!-- Logo button (toggles the sidebar) -->
  <Style Selector="Button.logo">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.logo:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
  </Style>

  <!-- Link button -->
  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentText}" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>
  <!-- Plain button around a pill (header status) -->
  <Style Selector="Button.bare">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.bare:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.bare:pointerover">
    <Setter Property="Opacity" Value="0.85" />
  </Style>

  <!-- ===================================================== Sidebar navigation -->
  <!-- The sidebar width animates; icons keep their x position (padding 16 = centered in the 72 px rail) -->
  <Style Selector="Border.sidebar">
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Width" Duration="0:0:0.24" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.sidebar TextBlock.navtext, Border.sidebar TextBlock.logotext">
    <Setter Property="Opacity" Value="1" />
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.sidebar.collapsed TextBlock.navtext, Border.sidebar.collapsed TextBlock.logotext">
    <Setter Property="Opacity" Value="0" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>
  <!-- Selected entry: neon icon on a chip (dark chip in light mode keeps the neon readable) -->
  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource BrushChip}" />
  </Style>
  <Style Selector="Button.nav.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushChip}" />
  </Style>
  <Style Selector="Button.nav.selected PathIcon.navicon">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentIcon}" />
  </Style>
  <Style Selector="Button.nav.selected TextBlock.navtext">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource BrushChipText}" />
  </Style>
  <!-- Sub entries: indented, a bit smaller -->
  <Style Selector="Button.nav.child">
    <Setter Property="Padding" Value="40,7,12,7" />
  </Style>
  <Style Selector="Button.nav.child TextBlock.navtext">
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="Button.nav.child PathIcon.navicon">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
  </Style>
  <!-- Group headers: accent icon, semibold title -->
  <Style Selector="Button.nav.group PathIcon.navicon">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentIcon}" />
  </Style>
  <Style Selector="Button.nav.group TextBlock.navtext">
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="PathIcon.chevron">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="RenderTransform" Value="rotate(0deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="PathIcon.chevron.expanded">
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
  </Style>
  <!-- Collapsed rail: square 44 × 44 highlight; the left edge stays where it was, so the icons do not move -->
  <Style Selector="Border.sidebar.collapsed Button.nav">
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="44" />
    <Setter Property="Padding" Value="12" />
    <Setter Property="Margin" Value="4,2,0,2" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <!-- Collapsed rail: sub pages of an open group sit in a soft box with an accent line on the left -->
  <Style Selector="Border.sidebar.collapsed ItemsControl.navchildren">
    <Setter Property="Margin" Value="2,0,0,6" />
    <Setter Property="Background" Value="{DynamicResource BrushNeutralSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushAccentIcon}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="CornerRadius" Value="4,12,12,4" />
    <Setter Property="Width" Value="50" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style Selector="Border.sidebar.collapsed Button.nav.child">
    <Setter Property="Margin" Value="2,2,0,2" />
  </Style>
  <Style Selector="Border.sidebar.collapsed Button.nav.child PathIcon.navicon">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
  </Style>
  <Style Selector="Border.navdivider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="6,8" />
    <Setter Property="Background" Value="{DynamicResource BrushBorder}" />
  </Style>

  <!-- ===================================================== Lists -->
  <Style Selector="ListBox.rows">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>
  <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
  </Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BrushAccentSoft}" />
    <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}" />
  </Style>

  <!-- ===================================================== Inputs -->
  <Style Selector="TextBox, ComboBox, NumericUpDown">
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccent}" />
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceRaised}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="MinHeight" Value="6" />
  </Style>
  <Style Selector="ProgressBar.thin">
    <Setter Property="MinHeight" Value="4" />
    <Setter Property="Height" Value="4" />
  </Style>
  <Style Selector="ProgressBar.failed">
    <Setter Property="Foreground" Value="{DynamicResource BrushDanger}" />
  </Style>
  <Style Selector="ProgressBar.done">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentPressed}" />
  </Style>

  <!-- Option rows: label left, control right in a fixed column; right edges line up -->
  <Style Selector="Grid.opts > TextBlock, Grid.opts > ComboBox, Grid.opts > ToggleSwitch, Grid.opts > NumericUpDown, Grid.opts > TextBox, Grid.opts > Grid, Grid.opts > StackPanel, Grid.opts > Border, Grid.opts > CheckBox, Grid.opts > Slider">
    <Setter Property="Margin" Value="0,0,0,10" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Grid.opts > TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,12,10" />
  </Style>
  <Style Selector="Grid.opts > ToggleSwitch">
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="MinWidth" Value="0" />
  </Style>
  <Style Selector="Grid.opts > NumericUpDown, Grid.opts > TextBox">
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Slider">
    <Setter Property="Margin" Value="0,-6,0,0" />
  </Style>
  <!-- Mini player progress in file rows: compact -->
  <Style Selector="Slider.mini">
    <Setter Property="Margin" Value="0,-10,0,-10" />
    <Setter Property="MinHeight" Value="24" />
  </Style>
  <!-- Mini player button: accent while playing -->
  <Style Selector="Button.minplay.playing PathIcon">
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentIcon}" />
  </Style>

  <!-- Card heading row: icon + title -->
  <Style Selector="StackPanel.cardhead">
    <Setter Property="Orientation" Value="Horizontal" />
    <Setter Property="Spacing" Value="10" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>
  <Style Selector="StackPanel.cardhead > PathIcon">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Foreground" Value="{DynamicResource BrushAccentIcon}" />
  </Style>

  <!-- Modal overlay (first start, FFmpeg setup): dimmed background, centered card -->
  <Style Selector="Border.dim">
    <Setter Property="Background" Value="#B3000000" />
  </Style>
  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="{DynamicResource BrushSurfaceCard}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BrushBorderStrong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Padding" Value="26,24" />
    <Setter Property="BoxShadow" Value="0 18 48 0 #66000000" />
  </Style>

  <Style Selector="TabItem">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="12,0" />
  </Style>

</Styles>
